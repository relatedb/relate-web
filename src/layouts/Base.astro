---
// Shared page shell for section pages (/docs, /blog, ...): head, global styles, top bar, footer.
// The home page still renders the legacy markup (src/pages/index.astro) but uses the same
// Header and Footer components and base.css.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteSearch from '../components/SiteSearch.astro';
import SeoHead from '../components/SeoHead.astro';
import Gtm from '../components/Gtm.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import type { JsonLd } from '../lib/seo.ts';
import '../styles/base.css';
interface Props {
  title: string;
  description?: string;
  playgroundHref?: string;
  /** `docs` swaps the top bar for the slotted docs header and lets the page fill the width (docs pages, recipe pages). */
  chrome?: 'site' | 'docs';
  /** The page's canonical path when it is not the request path (Docs and Cookbook pass their own). */
  path?: string;
  type?: 'website' | 'article';
  twinHref?: string;
  describedby?: string;
  modified?: string;
  jsonld?: JsonLd[];
  /** Never indexed, launch build included. */
  noindex?: boolean;
}
const { title, description = '', playgroundHref, chrome = 'site', path, type, twinHref, describedby, modified, jsonld, noindex } = Astro.props;
// The 404 page answers at every missing URL, so it has no canonical and is never indexed.
const notFound = Astro.url.pathname.replace(/\/$/, '') === '/404';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — relate</title>
    {description && <meta name="description" content={description} />}
    <SeoHead
      title={title}
      description={description}
      path={notFound ? undefined : (path ?? Astro.url.pathname)}
      type={type}
      twinHref={twinHref}
      describedby={describedby}
      modified={modified}
      jsonld={jsonld}
      noindex={noindex || notFound}
    />
    <link rel="preload" href="/fonts/relate-sans.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
    <slot name="head" />
    <Gtm />
  </head>
  <body>
    <ConsentBanner />
    {chrome === 'docs' ? <slot name="header" /> : <Header playgroundHref={playgroundHref} />}
    <main class={chrome === 'docs' ? 'page' : 'page container'} id="main">
      <slot />
    </main>
    <Footer />
    <SiteSearch />
  </body>
</html>
