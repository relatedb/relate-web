---
// The docs landing (/docs/, DOCS-PLAN.md §2 "Landing"): on the regular site
// shell with no sidebar. Above the fold, two columns: the title, search and three
// buttons, and the agent card (install, the setup prompt and the AGENTS.md block to copy, llms.txt).
// Then the task index as the one primary navigation (a ruled grid of cards, each
// headed by a link into its section) and a few cookbook examples. A task whose
// page is not written yet renders as text, not a link.
import RecipeCard from '../../components/cookbook/RecipeCard.astro';
import { agentsMd, setupPrompt } from '../../components/docs/install.ts';
import TabsStrip from '../../components/docs/TabsStrip.astro';
import Docs from '../../layouts/Docs.astro';
import { esc } from '../../lib/cookbook/result-view.ts';
import { highlighter } from '../../lib/docs/highlight.ts';
import Search from '../../components/docs/Search.astro';
import { pixels } from '../../lib/cookbook/pixel-icons.ts';
import { GROUP_BLURBS, orderedTasks, PRIMARY, taskHref } from '../../lib/docs/landing.ts';
import { CANONICAL_PHRASE } from '../../lib/docs/llms.ts';
import { collectionGraph } from '../../lib/seo.ts';
import { readingOrder } from '../../lib/docs/nav.ts';
import { byCategory } from '../../lib/cookbook/render.ts';
import { cookbook } from '../../lib/cookbook/site.ts';
import { docsSite } from '../../lib/docs/site.ts';

const site = await docsSite();
const published = site.links.pages;
const tasks = orderedTasks(site.order());
const highlight = await highlighter();
let seq = 0;
// A code block as the docs render one (dark, with a Copy button the script shows).
const code = (text: string, lang: string) => {
  const id = `landing-code-${++seq}`;
  return (
    `<div class="code-block">${highlight(text, lang)}<textarea id="${id}" hidden>${esc(text)}</textarea>` +
    `<button class="copy-btn" type="button" data-copy-target="${id}" hidden>Copy</button></div>`
  );
};
// Where each card's heading goes: the first page of its section (the sections have no page of their own).
const firstPage = (prefix: string) => readingOrder(site.nav).find((p) => p.id === prefix || p.id.startsWith(`${prefix}/`))?.id;
const GROUP_PAGE: Record<string, string | undefined> = {
  Evaluate: 'concepts/where-relate-fits',
  'Get started': firstPage('get-started'),
  Agents: firstPage('guides/agents'),
  Guides: firstPage('guides'),
  Reference: firstPage('reference'),
  Concepts: firstPage('concepts'),
};
const GROUP_MORE: Record<string, string> = {
  Evaluate: 'Where relate fits',
  'Get started': 'All tutorials',
  Agents: 'All agent guides',
  Guides: 'All guides',
  Reference: 'All reference',
  Concepts: 'All concepts',
};
const book = await cookbook();
const recipes = byCategory(book.pages.map((p) => p.recipe)).map((g) => g.recipes[0]).slice(0, 3);
const SHOWN = 6; // tasks a card lists; the rest are one click away in its section
const description = `Documentation for ${CANONICAL_PHRASE}: install it, connect an agent, look up a command or an error.`;
// On the page the domain is dropped; the meta description keeps the canonical phrase.
const lede = description.replace(' (relatedb.ai)', '');
// An icon per quick link, in PRIMARY's order (Get started, Connect your agent, Does relate fit?).
const QUICK_ICONS = ['Get started', 'Agents', 'Evaluate'];
const skillGuide = taskHref('guides/agents/install-the-skill', published);
---
<Docs title="Docs" description={description} nav={site.nav} current="" twinHref="/docs/index.md" landing jsonld={[collectionGraph('Docs', description, '/docs/')]}>
  <header class="landing-title">
    <p class="eyebrow"><a href="/">relate</a> / docs</p>
    <h1>Docs</h1>
    <p class="lede">{lede}</p>
  </header>

  <div class="landing-top">
    <div class="you-card">
      <p class="col-label">For you</p>
      <h2>Start here</h2>
      <div class="landing-search" data-pagefind-ignore><Search placeholder="Search the docs" /></div>
      <ul class="quick-links">
        {PRIMARY.map((b, i) => {
          const href = taskHref(b.page, published);
          const icon = pixels(QUICK_ICONS[i] ?? 'Guides');
          const row = (
            <>
              <svg class="cb-px" viewBox={`0 0 ${icon.w} ${icon.h}`} width={icon.w * 2} height={icon.h * 2} shape-rendering="crispEdges" fill="currentColor" aria-hidden="true"><path d={icon.d} /></svg>
              <span class="ql-text">{b.text}</span>
              <span class="ql-arrow" aria-hidden="true">&rarr;</span>
            </>
          );
          return <li>{href ? <a href={href}>{row}</a> : <span class="ql-pending" title="This page is not written yet">{row}</span>}</li>;
        })}
      </ul>
    </div>

    <aside class="agent-card" aria-labelledby="for-agents">
      <p class="col-label">For your agent</p>
      <h2 id="for-agents">Install, then hand it over</h2>
      <TabsStrip detect="os" tabs={[{ key: 'macos-linux', label: 'macOS and Linux' }, { key: 'windows', label: 'Windows' }]}>
        <Fragment slot="macos-linux">
          <Fragment set:html={code('curl -sSfL https://relatedb.ai/install.sh | bash', 'bash')} />
          <p class="agent-note">Checks the release's signed SHA256SUMS first, and installs to <code>~/.local/bin</code>.</p>
        </Fragment>
        <Fragment slot="windows">
          <p class="agent-note">
            <code>install.sh</code> runs on macOS and Linux. On Windows, paste the PowerShell block from <a href="/docs/get-started/install/">Install relate</a>: it makes the same checks, then installs <code>relate.exe</code> on your <code>PATH</code>.
          </p>
        </Fragment>
      </TabsStrip>
      <p class="agent-actions">
        <button class="agent-copy" type="button" data-copy-source="agent-prompt" hidden>
          <svg class="ic-copy" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
          <svg class="ic-check" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
          <span class="agent-copy-label">Copy setup prompt</span>
        </button>
        <a class="agent-link" href="/docs/llms.txt" target="_blank" rel="noopener">llms.txt</a>
      </p>
      <p class="agent-md" hidden>
        <button class="agent-copy agent-copy-quiet" type="button" data-copy-source="agent-md">
          <svg class="ic-copy" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
          <svg class="ic-check" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
          <span class="agent-copy-label">Copy AGENTS.md block</span>
        </button>
        <span class="agent-md-note">For your repository's <code>AGENTS.md</code> or <code>CLAUDE.md</code>: the install line, the safe defaults and the exit codes, for every session.</span>
      </p>
      <textarea id="agent-prompt" hidden>{setupPrompt()}</textarea>
      <textarea id="agent-md" hidden>{agentsMd()}</textarea>
    </aside>
  </div>

  <section class="landing-tasks" aria-labelledby="i-want-to">
    <h2 id="i-want-to">I want to…</h2>
    <ul class="task-grid">
      {tasks.map((g) => {
        const icon = pixels(g.id);
        const item = (t: (typeof g.tasks)[number]) => {
          const href = taskHref(t.page, published);
          return <li>{href ? <a href={href}>{t.text}</a> : <span class="is-pending" title="This page is not written yet">{t.text}</span>}</li>;
        };
        return (
          <li class="task-card">
            <svg class="cb-px" viewBox={`0 0 ${icon.w} ${icon.h}`} width={icon.w * 2} height={icon.h * 2} shape-rendering="crispEdges" fill="currentColor" aria-hidden="true"><path d={icon.d} /></svg>
            <h3>{GROUP_PAGE[g.id] ? <a href={`/docs/${GROUP_PAGE[g.id]}/`}>{g.id}</a> : g.id}</h3>
            <p class="task-blurb">{GROUP_BLURBS[g.id]}</p>
            <ul class="task-list">{g.tasks.slice(0, SHOWN).map(item)}</ul>
            {GROUP_PAGE[g.id] && <a class="task-all" href={`/docs/${GROUP_PAGE[g.id]}/`}>{GROUP_MORE[g.id]} <span aria-hidden="true">&rarr;</span></a>}
          </li>
        );
      })}
    </ul>
  </section>

  <section class="landing-cookbook" aria-labelledby="cookbook">
    <h2 id="cookbook">Learn from a recipe</h2>
    <p class="section-note">Worked examples with a small dataset and plain Cypher. Every step runs in your browser.</p>
    <div class="cookbook">
      <ul class="cb-grid">
        {recipes.map((r) => <RecipeCard recipe={r} />)}
      </ul>
    </div>
    <p class="section-more"><a href="/cookbook/">See all {book.pages.length} recipes <span aria-hidden="true">&rarr;</span></a></p>
  </section>

  <section class="landing-use" aria-labelledby="use-the-docs">
    <h2 id="use-the-docs">Using the docs with an agent</h2>
    <ul class="task-grid">
      <li class="task-card">
        <h3>Every page is markdown</h3>
        <p class="task-blurb">Add <code>.md</code> to any page's URL for the same page as plain text, the way an agent reads it. <a href="/docs/llms.txt" target="_blank" rel="noopener">llms.txt</a> lists every page by task.</p>
      </li>
      <li class="task-card">
        <h3>Install the skill</h3>
        <p class="task-blurb"><code>relate skill install</code> adds the relate skill to the agents it finds on your machine.</p>
        <Fragment set:html={code('relate skill install', 'bash')} />
        {skillGuide && <a class="task-all" href={skillGuide}>About the skill <span aria-hidden="true">&rarr;</span></a>}
      </li>
      <li class="task-card">
        <h3>Something wrong or missing?</h3>
        <p class="task-blurb">A page that is wrong, unclear or absent is reported from <a href="/docs/feedback.md">/docs/feedback.md</a>, which says how.</p>
        <a class="task-all" href="/docs/feedback.md">Report a wrong page <span aria-hidden="true">&rarr;</span></a>
      </li>
    </ul>
  </section>
</Docs>

<script>
  // The agent card's copy buttons: each copies its hidden source (the setup prompt, the AGENTS.md
  // block) and shows a tick for a moment. Without script they stay hidden.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-source]')) {
    const source = document.getElementById(btn.dataset.copySource ?? '') as HTMLTextAreaElement | null;
    if (!source) continue;
    btn.hidden = false;
    btn.closest<HTMLElement>('.agent-md')?.removeAttribute('hidden');
    const label = btn.querySelector<HTMLElement>('.agent-copy-label')!;
    const idle = label.textContent;
    let timer: number | undefined;
    const show = (done: boolean, text: string) => {
      btn.classList.toggle('is-done', done);
      label.textContent = text;
    };
    btn.addEventListener('click', async () => {
      let ok = true;
      try {
        await navigator.clipboard.writeText(source.value);
      } catch {
        ok = false;
      }
      show(ok, ok ? 'Copied' : 'Copy failed');
      clearTimeout(timer);
      timer = window.setTimeout(() => show(false, idle ?? ''), 1800);
    });
  }
</script>
