---
// /blog/: the posts, newest first, with the tags to browse by. With none published the page says so
// and stays out of search.
import Base from '../../layouts/Base.astro';
import PostList from '../../components/blog/PostList.astro';
import TagList from '../../components/blog/TagList.astro';
import { browsable, tagCounts } from '../../lib/blog.ts';
import '../../styles/blog.css';

// The dev server lists everything (drafts and unlisted, badged); production lists only listed posts.
const list = await browsable();
const counts = tagCounts(list);
---
<Base
  title="Related Posts"
  description="Release notes, engineering write-ups and design decisions from the relate project."
  path="/blog/"
  noindex={list.length === 0}
>
  <div class="blog">
    <header class="blog-head">
      <h1>Related Posts</h1>
      <a class="blog-rss" href="/blog/rss.xml">RSS</a>
    </header>
    {list.length === 0 ? (
      <p class="blog-empty">Nothing published yet. <a href="/">Back to the home page</a>.</p>
    ) : (
      <>
        <TagList tags={counts.map((c) => c.tag)} counts={Object.fromEntries(counts.map((c) => [c.tag, c.count]))} label="Browse by tag" />
        <PostList list={list} />
      </>
    )}
  </div>
</Base>
