---
import ThemeSwitch from './ThemeSwitch.astro';
// Site-wide footer: link columns, a legal row with the theme switch. Used by Base and the home page.
const cols = [
  { title: 'Build', links: [
    { href: '/#quickstart', label: 'Quickstart' },
    { href: '/docs/', label: 'Docs' },
    { href: '/playground/', label: 'Playground', external: true },
    { href: '/cookbook/', label: 'Cookbook' },
    { href: '/blog/', label: 'Blog' },
    { href: '/llms.txt', label: 'llms.txt' },
  ] },
  { title: 'Community', links: [
    { href: 'https://github.com/relatedb/relate', label: 'GitHub', external: true },
    { href: 'https://github.com/relatedb/relate/issues', label: 'Report an issue', external: true },
    { href: 'https://github.com/relatedb/relate/releases', label: 'Releases', external: true },
    { href: 'https://github.com/relatedb/relate-web/tree/main/src/content/cookbook#writing-a-recipe', label: 'Add a recipe', external: true },
  ] },
  { title: 'Project', links: [
    { href: 'https://github.com/relatedb/relate/blob/main/docs/tck/compliance.md', label: 'TCK compliance', external: true },
    { href: 'https://github.com/relatedb/relate/blob/main/docs/adr/', label: 'Decision records', external: true },
    { href: 'https://github.com/relatedb/relate/blob/main/LICENSE', label: 'License (Apache-2.0)', external: true },
    { href: '#top', label: 'Back to top' },
  ] },
];
import Feedback from './Feedback.astro';
import { indexable } from '../lib/seo.ts';
interface Props {
  /** The home page's play area: stickers that fall onto the relate arch. */
  play?: boolean;
}
const { play = false } = Astro.props;
---
<footer class={play ? 'foot edge has-play' : 'foot edge'}>
  <div class="fgrid">
    {cols.map((c) => (
      <nav class="fcell" aria-label={c.title}>
        <h3>{c.title}</h3>
        {c.links.map((l) => (
          <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}{l.external && <span class="sr-only"> (opens in new tab)</span>}</a>
        ))}
      </nav>
    ))}
  </div>
  {play && <div class="play" id="play"><canvas id="pc" aria-hidden="true"></canvas></div>}
  <div class="fb-wrap"><Feedback /></div>
  <div class="legal">
    <span class="legal-copy">&copy; 2026 The Relate Authors · <a href="https://github.com/relatedb/relate-web/blob/main/LICENSE" target="_blank" rel="noopener">Apache-2.0<span class="sr-only"> (opens in new tab)</span></a>{indexable() && <> · <button type="button" class="consent-open" data-consent-open>Cookie settings</button></>}</span>
    <div class="social">
      <a href="https://github.com/relatedb/relate" target="_blank" rel="noopener" aria-label="GitHub (opens in new tab)"><svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 .2a8 8 0 0 0-2.5 15.6c.4.1.5-.2.5-.4v-1.4c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.2 1.9.9 2.3.7.1-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8a7.500 7.500 0 0 1 4 0c1.500-1 2.200-.8 2.200-.8.4 1.100.2 1.900.1 2.100.5.6.8 1.300.8 2.100 0 3.100-1.900 3.800-3.600 4 .3.3.5.8.5 1.500v2.200c0 .2.1.5.6.4A8 8 0 0 0 8 .2z"/></svg></a>
    </div>
    <ThemeSwitch />
  </div>
</footer>

{play && <script is:inline src="/js/footer-play.js" defer></script>}
