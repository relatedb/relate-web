---
import { LOCKUP } from '../lib/home/lockup.ts';
import engine from '../content/docs/_data/engine.json';
// Site-wide top bar: lockup, links, GitHub and the call to action. Used by every
// page (home and sections) so navigation stays consistent. The theme picker lives in the footer.
interface Props {
  /** Where the Playground link goes: a recipe page opens its recipe there (`/playground/#recipe=<slug>`). */
  playgroundHref?: string;
}
const { playgroundHref = '/playground/' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// A section link is current on the section's own pages too (/cookbook/<slug>/).
const isCurrent = (href: string) => {
  if (href.includes('#') || /^https?:/.test(href)) return false;
  const h = href.replace(/\/$/, '') || '/';
  return path === h || (h !== '/' && path.startsWith(`${h}/`));
};
const GITHUB = 'https://github.com/relatedb/relate';
const DISCORD = 'https://discord.gg/neo4j';
// The current release (engine.json, so it tracks each re-pin), linking to its release notes.
const VERSION = `v${engine.version}`;
const links = [
  { href: '/docs/', label: 'Docs' },
  { href: '/cookbook/', label: 'Cookbook' },
  { href: '/blog/', label: 'Blog' },
  {
    href: playgroundHref,
    label: 'Playground',
    external: true,
    icon: true,
    title: playgroundHref === '/playground/' ? undefined : 'Open this recipe in the playground',
  },
  // On desktop GitHub is the pill on the right; the folded menu lists it here.
  { href: DISCORD, label: 'Discord', external: true, icon: true, cls: 'nl-gh' },
  { href: GITHUB, label: 'GitHub', external: true, icon: true, cls: 'nl-gh' },
];
---
<a class="skip" href="#main">Skip to content</a>
<header class="nav" id="top">
  <div class="nav-in">
    <a class="lockup" href="/" aria-label="relate, home" translate="no">
      <Fragment set:html={LOCKUP.replace('class="wm2"', 'class="lockup-mark"')} />
    </a>
    <nav class="nav-links" id="topNav" aria-label="Main">
      {links.map((l) => (
        <a class={'cls' in l ? l.cls : undefined} href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined} title={'title' in l ? l.title : undefined} aria-current={isCurrent(l.href) ? 'page' : undefined}>
          {l.label}{l.icon && <span aria-hidden="true">&nbsp;&#8599;</span>}{l.external && <span class="sr-only"> (opens in new tab)</span>}
        </a>
      ))}
    </nav>
    <div class="nav-right">
      <a class="nav-gh nav-dc" href={DISCORD} target="_blank" rel="noopener" aria-label="Neo4j Discord (opens in new tab)"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg></a>
      <a class="nav-gh" href={GITHUB} target="_blank" rel="noopener" aria-label="GitHub (opens in new tab)"><svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 .2a8 8 0 0 0-2.5 15.6c.4.1.5-.2.5-.4v-1.4c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.2 1.9.9 2.3.7.1-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8a7.5 7.5 0 0 1 4 0c1.5-1 2.2-.8 2.2-.8.4 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.1 0 3.1-1.9 3.8-3.6 4 .3.3.5.8.5 1.5v2.2c0 .2.1.5.6.4A8 8 0 0 0 8 .2z"/></svg></a>
      <a class="nav-ver" href={`${GITHUB}/releases`} target="_blank" rel="noopener" translate="no" title="Release notes on GitHub">{VERSION}<span class="sr-only"> release notes (opens in new tab)</span></a>
      <a class="nav-cta" href="/docs/">Get started</a>
      <button class="menu-btn" id="navToggle" type="button" aria-label="Open menu" aria-controls="topNav" aria-expanded="false"><span><i></i><i></i></span></button>
    </div>
  </div>
</header>

<script>
  // ---------- Sticky header shadow ----------
  const header = document.getElementById('top') as HTMLElement;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ---------- Mobile nav toggle ----------
  const navToggle = document.getElementById('navToggle');
  const topNav = document.getElementById('topNav');
  if (navToggle && topNav) {
    const closeNav = () => {
      topNav.classList.remove('open');
      navToggle.setAttribute('aria-expanded', 'false');
      navToggle.setAttribute('aria-label', 'Open menu');
    };
    navToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = topNav.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    topNav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') closeNav();
    });
    document.addEventListener('click', (e) => {
      if (!topNav.contains(e.target as Node) && !navToggle.contains(e.target as Node)) closeNav();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeNav();
    });
  }
</script>
