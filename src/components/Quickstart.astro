---
// Home "Quickstart": four steps that tick off in turn beside a prompt to paste into an agent.
// The steps, the status label and the copy button are the only script. The prompt is the setup prompt every
// copy-for-agent button shares (setupPrompt, ADR-0060); its commands are the docs' (get-started/agent-quickstart).
import { setupPrompt } from './docs/install.ts';

const PROMPT = setupPrompt();
const steps = [
  { h: 'Install the agent skill', p: 'One command, for the agents you already use.', tag: 'agent skill', href: '/docs/guides/agents/install-the-skill/', say: 'Installing the agent skill' },
  { h: 'Pick a storage format', p: 'In memory, a directory, or one .rl file.', tag: 'memory / directory / .rl', href: '/docs/guides/storage/choose-a-store-layout/', say: 'Picking a storage format' },
  { h: 'Create data', p: 'Write Cypher, load a CSV, or mirror from Aura.', tag: 'Cypher / CSV / Aura', href: '/docs/get-started/first-graph/', say: 'Adding your data' },
  { h: 'Query it', p: 'Tables for you, JSON for your agent.', tag: 'table / JSON', href: '/docs/guides/cli/output-formats/', say: 'Running your query' },
];

// A step marker: a ring, a spinner arc while the step runs, a solid brand check circle when it is done.
const marker =
  '<svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">' +
  '<circle class="r" cx="12" cy="12" r="9"/><path class="sp" d="M21 12a9 9 0 1 1-6.219-8.56"/>' +
  '<circle class="fl" cx="12" cy="12" r="10.5" stroke="none"/><path class="c" d="m8 12.5 3 3 5-6"/></svg>';
---
<section class="qs" id="quickstart" aria-labelledby="h-qs">
  <div class="qs-in">
    <div class="qs-head">
      <p class="eyebrow">Quickstart</p>
      <h2 id="h-qs">Four steps to your first query.</h2>
    </div>
    <div class="qbox" data-say={JSON.stringify(steps.map((s) => s.say))}>
      <ol class="qrows">
        {steps.map((s, i) => (
          <li>
            <button class="qhit" type="button" data-step={i} aria-label={`Replay from step ${i + 1}: ${s.h}`}></button>
            <i class="qsq" aria-hidden="true" set:html={marker} />
            <div><h3>{s.h}</h3><p>{s.p}</p><a class="qdoc" href={s.href}>Read the guide<span aria-hidden="true">&nbsp;&rarr;</span><span class="sr-only"> for {s.h.toLowerCase()}</span></a></div>
            <span class="qtag" translate="no">{s.tag}</span>
          </li>
        ))}
      </ol>
      <div class="qprompt">
        <div class="qmas">
          <span class="qsay" aria-hidden="true"><b id="qsay">Hi, set me up</b></span>
        </div>
        <div class="qpanel">
          <div class="qpbody">
            <p class="qp-t" id="qp-text" translate="no" tabindex="0" role="region" aria-label="Setup prompt (scrolls)">{PROMPT}</p>
            <button class="qcopy" type="button" id="qp-copy" aria-label="Copy prompt" data-prompt={PROMPT}>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect><path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H3A1.5 1.5 0 0 0 1.5 3v6A1.5 1.5 0 0 0 3 10.5h.5"></path></svg>
            </button>
          </div>
          <div class="qfoot">
            <button type="button" class="qfa" id="qp-agent" data-prompt={PROMPT}>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect><path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H3A1.5 1.5 0 0 0 1.5 3v6A1.5 1.5 0 0 0 3 10.5h.5"></path></svg>
              <span class="qfa-t">Copy prompt for agent</span>
            </button>
            <a class="qfd" href="/docs/get-started/install/">Read docs<span aria-hidden="true">&nbsp;&#8599;</span></a>
          </div>
          <p class="sr-only" id="qp-live" role="status" aria-live="polite"></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .qs { padding: 0 24px 120px; background: var(--surface-0); border-top: 1px solid var(--line); }
  .qs-in { max-width: var(--page-w); margin: 0 auto; }
  .qs-head { padding: 112px 0 56px; }
  .eyebrow { margin: 0; font: 500 12px/16px var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-muted); }
  h2 { margin: 16px 0 0; max-width: 16ch; font: 500 clamp(30px, 3.2vw, 48px) / 1.04 var(--font); letter-spacing: -.04em; color: var(--ink); }

  .qbox {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: stretch;
    border: 1px solid var(--line-strong); background: var(--win); box-shadow: var(--ui-shadow); overflow: hidden;
  }
  .qrows { display: flex; flex-direction: column; list-style: none; margin: 0; padding: 0; border-right: 1px solid var(--line); }
  .qrows li {
    position: relative; flex: 1; display: grid; grid-template-columns: 21px minmax(0, 1fr); column-gap: 16px; row-gap: 12px;
    align-content: center; align-items: start; padding: 24px 32px; border-bottom: 1px solid var(--line); transition: background-color .3s;
  }
  .qrows li:last-child { border-bottom: 0; }
  .qhit { position: absolute; inset: 0; z-index: 1; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
  .qhit:hover { background: color-mix(in srgb, var(--ink) 4%, transparent); }
  .qhit:focus-visible { outline: 0; box-shadow: inset 0 0 0 2px var(--focus); }
  .qrows li.cur { background: var(--surface-2); }
  .qrows h3 { margin: 0; font: 500 18px/26px var(--font); letter-spacing: -.01em; color: var(--ink); }
  .qrows p { margin: 2px 0 0; font-size: 14px; line-height: 22px; color: var(--ink-muted); }
  .qrows li > div { grid-column: 2; grid-row: 1; }
  /* Above the row's replay button (z-index 1), so the link goes to the docs and the rest of the row replays. */
  .qdoc { position: relative; z-index: 2; display: inline-block; margin-top: 6px; font: 500 13px/20px var(--font); color: var(--brand); text-decoration: none; }
  .qdoc:hover { text-decoration: underline; }
  .qdoc:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .qtag {
    grid-column: 2; grid-row: 2; justify-self: start; max-width: 100%; padding: 2px 7px; border: 1px solid var(--line);
    font: 400 11px/1.4 var(--mono); color: var(--ink-muted);
  }
  .qsq { grid-row: 1 / 3; grid-column: 1; margin-top: 3px; display: block; width: 21px; height: 21px; color: var(--ink-muted); transition: color .4s; }
  .qsq :global(svg) { display: block; width: 21px; height: 21px; overflow: visible; }
  .qsq :global(.r) { opacity: .45; stroke: currentColor; }
  .qsq :global(.sp) { opacity: 0; transform-origin: 12px 12px; }
  .qsq :global(.fl) { fill: var(--brand); opacity: 0; transform: scale(.6); transform-origin: 12px 12px; transition: opacity .25s ease, transform .25s ease; }
  .qsq :global(.c) { stroke: var(--surface-0); stroke-dasharray: 14; stroke-dashoffset: 14; transition: stroke-dashoffset .35s ease .1s; }
  .qrows li.cur:not(.done) .qsq { color: var(--ink); }
  .qrows li.cur:not(.done) .qsq :global(.r) { opacity: .25; }
  .qrows li.cur:not(.done) .qsq :global(.sp) { opacity: 1; animation: qspin .8s linear infinite; }
  .qrows li.done .qsq :global(.r) { opacity: 0; }
  .qrows li.done .qsq :global(.fl) { opacity: 1; transform: scale(1); }
  .qrows li.done .qsq :global(.c) { stroke-dashoffset: 0; }
  @keyframes qspin { to { transform: rotate(360deg); } }

  /* The prompt side: brand blue, a status label above the prompt panel. */
  .qprompt {
    --bg: #0A6190;
    position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; justify-content: center;
    padding: var(--qpad, 64px) 72px 88px; background: var(--bg);
  }
  .qmas { display: flex; justify-content: center; align-self: center; margin: 0 0 16px; }
  .qsay { background: #111214; color: #fff; font: 500 12px/16px var(--mono); padding: 8px 11px; white-space: nowrap; border-radius: 6px; }
  .qsay b { font-weight: 500; }
  .qsay b::after { content: ''; display: inline-block; width: 6px; height: 11px; margin-left: 3px; vertical-align: -2px; background: currentColor; animation: qcur 1s steps(1) infinite; }
  @keyframes qcur { 50% { opacity: 0; } }

  .qpanel {
    width: 100%; padding: 8px; background: #fff; border: 1px solid rgba(0,0,0,.45);
    box-shadow: 0 10px 28px -8px rgba(0,0,0,.35);
  }
  :global(:root:not([data-theme='light'])) .qpanel { background: var(--surface-1); }
  @media (prefers-color-scheme: light) { :global(:root:not([data-theme='dark'])) .qpanel { background: #fff; } }
  .qpbody { position: relative; min-height: 200px; padding: 24px 64px 24px 24px; background: transparent; border: 1px solid var(--line); }
  /* The prompt shows its first seven lines and scrolls for the rest; the fade says there is more until the end is reached. */
  .qp-t {
    margin: 0; max-height: 154px; overflow-y: auto; overscroll-behavior: contain;
    font: 400 13px/22px var(--mono); color: var(--ink-muted); overflow-wrap: anywhere; white-space: pre-line;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 44px), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 44px), transparent);
  }
  .qp-t.end { -webkit-mask-image: none; mask-image: none; }
  .qp-t:focus-visible { outline: 2px solid var(--focus, var(--ink)); outline-offset: 4px; }
  .qcopy {
    position: absolute; top: 8px; right: 8px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;
    background: var(--surface-1); border: 1px solid var(--line); color: var(--ink-muted); cursor: pointer;
  }
  .qcopy:hover { color: var(--ink); }
  .qfoot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 0 0; }
  .qfa, .qfd {
    display: inline-flex; align-items: center; gap: 10px; min-height: 40px; padding: 0 12px; background: none; border: 0;
    color: var(--ink-muted); font: 500 14px/1 var(--font); cursor: pointer; text-decoration: none; white-space: nowrap;
  }
  .qfa:hover, .qfd:hover { color: var(--ink); }
  .qcopy:focus-visible, .qfa:focus-visible, .qfd:focus-visible { outline: 0; box-shadow: inset 0 0 0 2px var(--focus); }

  @media (max-width: 900px) {
    .qs { padding: 0 16px 96px; }
    .qs-head { padding: 72px 0 32px; }
    .qbox { grid-template-columns: minmax(0, 1fr); }
    .qrows { border-right: 0; border-bottom: 1px solid var(--line); }
    .qrows li { padding: 20px 16px; }
    .qprompt { padding: 32px 16px 56px; }
    .qpbody { min-height: 180px; }
    .qfoot { flex-wrap: wrap; }
    .qfa, .qfd { padding: 0 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .qsay b::after, .qrows li.cur:not(.done) .qsq :global(.sp) { animation: none; }
    .qsq :global(.c), .qsq :global(.fl) { transition: none; }
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>('.qbox');
  if (box) {
    const rows = [...box.querySelectorAll<HTMLElement>('.qrows li')];
    const say = box.querySelector<HTMLElement>('#qsay')!;
    const phases: string[] = JSON.parse(box.dataset.say ?? '[]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const live = box.querySelector<HTMLElement>('#qp-live')!;

    // Steps tick off in turn while the block is on screen, then the loop restarts. Clicking a step
    // replays the animation from that step: the steps before it are done, it and the rest start over.
    const hits = [...box.querySelectorAll<HTMLButtonElement>('.qhit')];
    if (reduced) {
      rows.forEach((r) => r.classList.add('done'));
      say.textContent = 'Ask me in Cypher';
      hits.forEach((h) => h.addEventListener('click', () => { say.textContent = phases[Number(h.dataset.step)] ?? ''; }));
    } else {
      let k = 0, tm: ReturnType<typeof setTimeout> | undefined, visible = false;
      const step = () => {
        if (!visible) return;
        if (k < rows.length) {
          rows.forEach((r, i) => r.classList.toggle('cur', i === k));
          say.textContent = phases[k] ?? '';
          tm = setTimeout(() => { rows[k].classList.add('done'); k++; tm = setTimeout(step, 1100); }, 1700);
        } else {
          rows.forEach((r) => r.classList.remove('cur'));
          say.textContent = 'Done. Ask me in Cypher';
          tm = setTimeout(() => { rows.forEach((r) => r.classList.remove('done')); k = 0; say.textContent = 'Hi, set me up'; tm = setTimeout(step, 1100); }, 5000);
        }
      };
      new IntersectionObserver((es) => {
        visible = es[0].isIntersecting;
        clearTimeout(tm);
        if (visible) tm = setTimeout(step, 700);
      }).observe(box);
      hits.forEach((h) => h.addEventListener('click', () => {
        const to = Number(h.dataset.step);
        clearTimeout(tm);
        visible = true;
        k = to;
        rows.forEach((r, i) => { r.classList.toggle('done', i < to); r.classList.remove('cur'); });
        step();
      }));
    }

    const write = async (text: string) => {
      try { await navigator.clipboard.writeText(text); return true; } catch { return false; }
    };
    let fb: ReturnType<typeof setTimeout> | undefined;
    const confirm = (ok: boolean) => {
      live.textContent = ok ? 'Copied. Paste it into your agent.' : 'Copy failed. Select the prompt and copy it.';
      clearTimeout(fb);
      fb = setTimeout(() => { live.textContent = ''; }, 2500);
    };
    // Drop the prompt's fade once it is scrolled to the end (or when it fits without scrolling).
    const text = box.querySelector<HTMLElement>('#qp-text')!;
    const atEnd = () => text.classList.toggle('end', text.scrollTop + text.clientHeight >= text.scrollHeight - 2);
    text.addEventListener('scroll', atEnd, { passive: true });
    atEnd();
    const agent = box.querySelector<HTMLButtonElement>('#qp-agent')!;
    const label = agent.querySelector<HTMLElement>('.qfa-t')!;
    for (const b of [box.querySelector<HTMLButtonElement>('#qp-copy')!, agent]) {
      b.addEventListener('click', async () => {
        const ok = await write(b.dataset.prompt ?? '');
        confirm(ok);
        if (ok) {
          label.textContent = 'Paste it into your agent';
          setTimeout(() => { label.textContent = 'Copy prompt for agent'; }, 2500);
        }
      });
    }
  }
</script>
